# Aas-Paas Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.

# ============================================================
# SUPABASE (Required)
# Get from: Supabase Dashboard → Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# APP URL (Required for production)
# Set to your Vercel deployment URL in production.
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# GOOGLE OAUTH (Optional — not required for MVP)
# Only needed if you enable Google sign-in.
# Get from: Google Cloud Console → Credentials
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# MAPBOX (Optional — NOT required for MVP)
# Only add this if you add a map UI in V1.1.
# The core location engine works WITHOUT Mapbox.
# ============================================================
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ============================================================
# SMS / PHONE OTP (Optional — NOT required for MVP)
# Add when you enable phone verification in a future release.
# ============================================================
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_SENDER_ID=

# ============================================================
# SECURITY NOTES
# - SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the browser
# - Never hard-code secrets in source code
# - Never commit this file with real values
# - Rotate keys immediately if accidentally committed
# ============================================================
